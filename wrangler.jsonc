{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "i90sdet",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/content.json",
      "/event-media/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BAND_CONTENT",
        "class_name": "BandContent"
      }
    ]
  },
  "exports": {
    "BandContent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
